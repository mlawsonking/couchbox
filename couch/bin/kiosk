#!/bin/bash
# /opt/couch/bin/kiosk - the program the kiosk's X server runs full-screen on the TV (xinit client, see
# installer/files/systemd/couch-kiosk.service).
# Prefers the Couch launcher (pygame-ce). If the launcher is missing, cannot import pygame, or has crashed 3 times
# in a row within a minute of starting, falls back to moonlight-qt's own gamepad-navigable GUI so the TV always
# shows something that can start a stream. (Phase 1 shipped with only the fallback.)
set -u
COUCH_ROOT="${COUCH_ROOT:-/opt/couch}"
LOG_DIR="${COUCH_LOG_DIR:-/var/log/couch}"
STATE_DIR="${COUCH_STATE_DIR:-/var/lib/couch}"
STRIKES_FILE="$STATE_DIR/launcher-strikes"
# Everything here is an X11 client (xinit set DISPLAY): Qt's xcb plugin (the only one in the moonlight-qt AppImage)
# and SDL's x11 driver for the launcher.
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-x11}"
# pam_systemd creates /run/user/<uid> for the kiosk's logind session, but the variable does not reach the service's
# environment; without it Qt falls back to /tmp/runtime-couch (moonlight.log "XDG_RUNTIME_DIR not set").
if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

log() { printf '%s kiosk: %s\n' "$(date -Is)" "$*" >>"$LOG_DIR/kiosk.log" 2>/dev/null || true; }
strikes() { cat "$STRIKES_FILE" 2>/dev/null || echo 0; }

# A kiosk never blanks on its own: the X server's screen saver and DPMS timeouts are off; the launcher dims the TV
# after 10 min and switches it off after 60 min idle through couch-display-power (xset dpms force off/on).
if [ -n "${DISPLAY:-}" ] && command -v xset >/dev/null 2>&1; then
    xset s off s noblank dpms 0 0 0 >/dev/null 2>&1 || log "xset failed (screen blanking stays at X defaults)"
fi

# The X screen's mode must equal the stream's mode: with no window manager nothing honours a fullscreen request, and
# moonlight-qt then opens a window only as big as the stream, centered (a 1080p stream filled a quarter of the 4K screen,
# NUC 2026-11-09). couch.display puts the screen on couch.toml [display] kiosk_mode (default 1920x1080@60) before the
# first frame; a stream of another size switches it for its duration (backend.py). Never fatal: on failure the screen
# stays on the TV's preferred mode and the launcher still works.
if [ -n "${DISPLAY:-}" ]; then
    PY="$COUCH_ROOT/venv/bin/python"; [ -x "$PY" ] || PY=python3
    if note=$(PYTHONPATH="$COUCH_ROOT/app" timeout 20 "$PY" -m couch.display base 2>&1); then
        log "display: $note"
    else
        log "display: could not set the kiosk mode (${note:-no output})"
    fi
fi

fallback() {
    log "starting moonlight-qt fallback GUI ($1)"
    exec "$COUCH_ROOT/bin/moonlight-qt"
}

if ! { [ -x "$COUCH_ROOT/venv/bin/python" ] && [ -d "$COUCH_ROOT/app/couch" ] &&
       "$COUCH_ROOT/venv/bin/python" -c 'import pygame' >/dev/null 2>&1; }; then
    fallback "launcher not available"
fi
if [ "$(strikes)" -ge 3 ]; then
    # Reset so the next kiosk restart (e.g. after the moonlight GUI is closed) tries the launcher again.
    echo 0 >"$STRIKES_FILE" 2>/dev/null || true
    fallback "launcher crashed 3 times in a row"
fi

log "starting Couch launcher"
start=$(date +%s)
cd "$COUCH_ROOT/app" || fallback "no app dir"
"$COUCH_ROOT/venv/bin/python" -m couch.launcher
rc=$?
if [ "$rc" -ne 0 ] && [ $(( $(date +%s) - start )) -lt 60 ]; then
    echo $(( $(strikes) + 1 )) >"$STRIKES_FILE" 2>/dev/null || true
    log "launcher exited rc=$rc after $(( $(date +%s) - start ))s (strike $(strikes))"
else
    echo 0 >"$STRIKES_FILE" 2>/dev/null || true
    log "launcher exited rc=$rc"
fi
exit "$rc"
