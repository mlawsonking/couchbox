#!/usr/bin/python3
"""couch-doctor - read-only health matrix for the couchbox NUC (Python stdlib only).

  couch-doctor [--json] [--measure] [--sysroot DIR]

v1 matrix: display (DRM connectors), gamepad (the three driver paths + /dev/input + SDL), decode caps (vainfo),
network path to the workstation (wired/wireless, ping jitter + loss; --measure adds a 10 s iperf3 throughput probe
and records the recommended quality rung), Moonlight pairing, Sunshine reachable, services, gamepad driver after
kernel updates, disk, last 3 streams. Exit code: 0 green, 1 any yellow, 2 any red.
Never changes anything. --sysroot points /sys, /proc, /dev and /etc lookups at a fixture tree (tests).
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import re
import shutil
import socket
import statistics
import subprocess
import sys
import time

try:
    import tomllib
except ImportError:  # pragma: no cover - Ubuntu 24.04 ships Python 3.12
    tomllib = None

VERSION = "1"
GREEN, YELLOW, RED, SKIP = "green", "yellow", "red", "skip"
_RANK = {SKIP: 0, GREEN: 0, YELLOW: 1, RED: 2}

# Xbox Wireless Adapter USB product ids (vendor 045e) handled by xone.
DONGLE_PIDS = {"02e6", "02fe", "02f9", "091e"}

SYSROOT = "/"


def p(path: str) -> str:
    """Map an absolute system path under --sysroot."""
    return os.path.join(SYSROOT, path.lstrip("/"))


def read(path: str, default: str = "") -> str:
    try:
        with open(p(path), encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return default


def run(argv: list[str], timeout: float = 10.0) -> tuple[int, str]:
    try:
        cp = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False)
        return cp.returncode, (cp.stdout or "") + (cp.stderr or "")
    except FileNotFoundError:
        return 127, f"{argv[0]}: not installed"
    except subprocess.TimeoutExpired:
        return 124, f"{argv[0]}: timed out after {timeout:.0f}s"


def result(name: str, status: str, summary: str, detail: dict | None = None) -> dict:
    return {"check": name, "status": status, "summary": summary, "detail": detail or {}}


# ------------------------------------------------------------------ display
def check_display() -> dict:
    connectors = []
    for status_file in sorted(glob.glob(p("/sys/class/drm/card*-*/status"))):
        d = os.path.dirname(status_file)
        name = os.path.basename(d)
        with open(status_file, encoding="utf-8") as fh:
            st = fh.read().strip()
        modes = []
        try:
            with open(os.path.join(d, "modes"), encoding="utf-8") as fh:
                modes = [m.strip() for m in fh if m.strip()]
        except OSError:
            pass
        connectors.append({"connector": name, "status": st, "preferred_mode": modes[0] if modes else None,
                           "modes": modes[:8]})
    connected = [c for c in connectors if c["status"] == "connected"]
    if not connectors:
        return result("display", RED, "no display hardware found (no DRM connectors)", {"connectors": []})
    if not connected:
        return result("display", RED, "no TV detected on any HDMI/DP port - is the TV on and the cable in?",
                      {"connectors": connectors})
    c = connected[0]
    return result("display", GREEN, f"{c['connector']} connected, preferred {c['preferred_mode'] or 'unknown'}",
                  {"connectors": connectors})


# ------------------------------------------------------------------ gamepad
def input_devices() -> list[dict]:
    devs, cur = [], {}
    for line in read("/proc/bus/input/devices").splitlines() + [""]:
        if not line.strip():
            if cur:
                devs.append(cur)
            cur = {}
            continue
        if line.startswith("N: Name="):
            cur["name"] = line.split("=", 1)[1].strip().strip('"')
        elif line.startswith("H: Handlers="):
            cur["handlers"] = line.split("=", 1)[1].split()
        elif line.startswith("I: "):
            cur["id"] = dict(kv.split("=", 1) for kv in line[3:].split() if "=" in kv)
    return devs


def module_loaded(name: str) -> bool:
    return os.path.isdir(p(f"/sys/module/{name}"))


def usb_ids() -> set[tuple[str, str]]:
    ids = set()
    for d in glob.glob(p("/sys/bus/usb/devices/*")):
        try:
            with open(os.path.join(d, "idVendor"), encoding="utf-8") as v, \
                    open(os.path.join(d, "idProduct"), encoding="utf-8") as pr:
                ids.add((v.read().strip().lower(), pr.read().strip().lower()))
        except OSError:
            continue
    return ids


def sdl_controllers() -> dict:
    py = p("/opt/couch/venv/bin/python")
    if not os.path.exists(py):
        return {"status": SKIP, "note": "launcher venv not installed yet (P2); SDL enumeration skipped"}
    code = ("import os;os.environ['SDL_VIDEODRIVER']='dummy';import pygame;pygame.init();pygame.joystick.init();"
            "import json;print(json.dumps([pygame.joystick.Joystick(i).get_name() "
            "for i in range(pygame.joystick.get_count())]))")
    rc, out = run([py, "-c", code], timeout=15)
    if rc != 0:
        return {"status": YELLOW, "note": f"SDL enumeration failed (rc {rc})", "output": out[-400:]}
    try:
        names = json.loads(out.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return {"status": YELLOW, "note": "SDL enumeration printed nothing parseable"}
    return {"status": GREEN if names else YELLOW, "controllers": names}


def check_gamepad() -> dict:
    devs = input_devices()
    pads = [d for d in devs if any(h.startswith("js") for h in d.get("handlers", []))]
    usb = usb_ids()
    dongle_present = any(v == "045e" and pid in DONGLE_PIDS for v, pid in usb)
    hci = sorted(os.path.basename(x) for x in glob.glob(p("/sys/class/bluetooth/hci*")))
    paths = {
        "dongle": {"driver": "xone_dongle", "loaded": module_loaded("xone_dongle"), "adapter_plugged": dongle_present,
                   "firmware": sorted(os.path.basename(f) for f in glob.glob(p("/lib/firmware/xone_dongle_*.bin")))},
        "bluetooth": {"driver": "hid_xpadneo", "loaded": module_loaded("hid_xpadneo"), "adapters": hci},
        "wired": {"driver": "xone_wired" if module_loaded("xone_wired") else "xpad",
                  "loaded": module_loaded("xone_wired") or module_loaded("xpad")},
    }
    detail = {"paths": paths, "joysticks": [{"name": d.get("name"), "handlers": d.get("handlers")} for d in pads],
              "sdl": sdl_controllers()}
    problems = []
    if dongle_present and not paths["dongle"]["loaded"]:
        problems.append("Xbox adapter plugged in but xone_dongle is not loaded")
    if dongle_present and not paths["dongle"]["firmware"]:
        problems.append("Xbox adapter firmware missing")
    if pads:
        names = ", ".join(sorted({d.get("name") or "?" for d in pads}))
        status = YELLOW if problems else GREEN
        return result("gamepad", status, f"{len(pads)} gamepad(s): {names}" + (f"; {'; '.join(problems)}"
                                                                              if problems else ""), detail)
    if problems:
        return result("gamepad", RED, "; ".join(problems), detail)
    any_driver = paths["dongle"]["loaded"] or (paths["bluetooth"]["loaded"] and hci) or paths["wired"]["loaded"]
    if not any_driver and not dongle_present:
        return result("gamepad", YELLOW, "no gamepad connected and no gamepad driver loaded yet "
                                         "(they load when a pad or the adapter is plugged in)", detail)
    return result("gamepad", YELLOW, "no gamepad connected - turn the controller on (Xbox button)", detail)


# ------------------------------------------------------------------ decode caps
VAAPI_RE = re.compile(r"^\s*(VAProfile\w+)\s*:\s*(VAEntrypoint\w+)", re.M)


def parse_vainfo(text: str) -> dict:
    vld = sorted({prof for prof, ep in VAAPI_RE.findall(text) if ep == "VAEntrypointVLD"})
    caps = {
        "h264": any(x.startswith("VAProfileH264") for x in vld),
        "hevc": "VAProfileHEVCMain" in vld,
        "hevc10": "VAProfileHEVCMain10" in vld,
        "av1": any(x.startswith("VAProfileAV1") for x in vld),
    }
    m = re.search(r"Driver version:\s*(.+)", text)
    # Decode generation heuristic only bounds the mode; the measured network link decides the default rung.
    if caps["av1"] or caps["hevc10"]:
        ceiling = "4k60"
    elif caps["hevc"] or caps["h264"]:
        ceiling = "1080p60"
    else:
        ceiling = None
    codec = "HEVC" if caps["hevc"] else ("H.264" if caps["h264"] else None)
    return {"vld_profiles": vld, "caps": caps, "driver": m.group(1).strip() if m else None,
            "decode_ceiling": ceiling, "recommended_codec": codec}


def check_decode() -> dict:
    nodes = sorted(glob.glob(p("/dev/dri/renderD*")))
    if not nodes:
        return result("decode", RED, "no GPU render node (/dev/dri/renderD*) - no hardware video decode", {})
    rc, out = run(["vainfo", "--display", "drm", "--device", "/dev/dri/" + os.path.basename(nodes[0])])
    info = parse_vainfo(out)
    info["render_node"] = os.path.basename(nodes[0])
    if rc != 0 and not info["vld_profiles"]:
        info["output"] = out[-600:]
        return result("decode", RED, f"vainfo failed (rc {rc}) - VA-API driver missing?", info)
    if not (info["caps"]["hevc"] or info["caps"]["h264"]):
        return result("decode", RED, "GPU has no H.264/HEVC hardware decode", info)
    status = GREEN if info["caps"]["hevc"] else YELLOW
    have = ", ".join(k.upper() for k, v in info["caps"].items() if v)
    return result("decode", status, f"hardware decode: {have}; ceiling {info['decode_ceiling']}; "
                                    f"codec {info['recommended_codec']}", info)


# ------------------------------------------------------------------ services
def check_services() -> dict:
    detail = {}
    bad = []
    for unit in ("couch-kiosk.service", "couch-daemon.service"):
        _, active = run(["systemctl", "is-active", unit])
        _, enabled = run(["systemctl", "is-enabled", unit])
        detail[unit] = {"active": active.strip(), "enabled": enabled.strip()}
        if active.strip() != "active":
            bad.append(f"{unit} {active.strip() or 'unknown'}")
        if unit == "couch-daemon.service" and active.strip() == "inactive" and enabled.strip() == "not-found":
            bad.pop()           # daemon not installed (P1/P2 box)
            continue
        if enabled.strip() != "enabled":
            bad.append(f"{unit} not enabled")
    _, getty = run(["systemctl", "is-enabled", "getty@tty1.service"])
    detail["getty@tty1.service"] = getty.strip()
    if getty.strip() != "masked":
        bad.append("getty@tty1 not masked (login prompt may appear on the TV)")
    pending = os.path.exists(p("/var/lib/couch/firstboot-pending"))
    detail["firstboot_pending"] = pending
    if pending:
        bad.append("first-boot install not finished")
    if bad:
        return result("services", RED, "; ".join(bad), detail)
    return result("services", GREEN, "kiosk running, tty1 login masked", detail)


# ------------------------------------------------------------------ config / workstation
CONFIG = os.environ.get("COUCH_CONFIG", "/etc/couch/couch.toml")
STATE = "/var/lib/couch"
MOONLIGHT = os.environ.get("COUCH_MOONLIGHT", "/opt/couch/bin/moonlight-qt")
LADDER = [("4k60-40", 40000), ("1440p60-30", 30000), ("1080p60-20", 20000), ("1080p60-15", 15000),
          ("720p60-10", 10000)]
JITTER_BAD_MS = 10.0
LOSS_BAD_PCT = 0.5


def load_config() -> dict:
    try:
        with open(CONFIG, "rb") as fh:
            return tomllib.load(fh) if tomllib else {}
    except (OSError, ValueError):
        return {}


def workstation() -> tuple[str, str | None, str]:
    """(host name, IPv4 or None, how it was found) - name/mDNS first, then the daemon's last-known cache."""
    host = (load_config().get("host") or {}).get("name") or "gamepc.local"
    try:
        return host, socket.getaddrinfo(host, None, socket.AF_INET)[0][4][0], "name"
    except (OSError, IndexError):
        pass
    try:
        with open(p(STATE + "/host-cache.json"), encoding="utf-8") as fh:
            d = json.load(fh)
        if d.get("host") == host and d.get("ip"):
            return host, d["ip"], "cache"
    except (OSError, ValueError):
        pass
    return host, None, "none"


def parse_ping(text: str) -> dict:
    times = [float(x) for x in re.findall(r"time[=<]([0-9.]+) ?ms", text)]
    m = re.search(r"(\d+) packets transmitted, (\d+) (?:packets )?received", text)
    sent, recv = (int(m.group(1)), int(m.group(2))) if m else (0, 0)
    loss = 100.0 * (sent - recv) / sent if sent else 100.0
    jitter = statistics.mean(abs(a - b) for a, b in zip(times, times[1:])) if len(times) > 1 else None
    return {"sent": sent, "received": recv, "loss_pct": round(loss, 2),
            "rtt_avg_ms": round(statistics.mean(times), 2) if times else None,
            "rtt_max_ms": max(times) if times else None, "jitter_ms": round(jitter, 2) if jitter is not None else None}


def recommend_rung(mbps: float | None, jitter: float | None, loss: float | None) -> str:
    """Highest ladder rung whose bitrate is at most half the measured throughput; one rung lower on a jittery
    or lossy link. Without a measurement the default 1080p60 15 Mbps stays."""
    if mbps is None:
        return "1080p60-15"
    names = [n for n, kbps in LADDER if kbps / 1000.0 <= mbps / 2.0] or ["720p60-10"]
    rung = names[0]
    if (jitter or 0) > JITTER_BAD_MS or (loss or 0) > LOSS_BAD_PCT:
        order = [n for n, _ in LADDER]
        rung = order[min(order.index(rung) + 1, len(order) - 1)]
    return rung


def iface_kind() -> list[dict]:
    out = []
    for d in sorted(glob.glob(p("/sys/class/net/*"))):
        name = os.path.basename(d)
        if name == "lo" or name.startswith(("docker", "veth", "br-", "virbr")):
            continue
        state = read(f"/sys/class/net/{name}/operstate").strip()
        kind = "wireless" if os.path.isdir(os.path.join(d, "wireless")) or os.path.isdir(os.path.join(d, "phy80211")) \
            else "wired"
        out.append({"iface": name, "kind": kind, "state": state})
    return out


def check_network(measure: bool = False) -> dict:
    host, ip, how = workstation()
    ifaces = iface_kind()
    up = [i for i in ifaces if i["state"] == "up"]
    detail = {"host": host, "ip": ip, "found_by": how, "interfaces": ifaces}
    if not up:
        return result("network", RED, "the box has no network connection (no interface up)", detail)
    if not ip:
        return result("network", RED, f"cannot find {host} (name lookup failed, no cached address)", detail)
    rc, out = run(["ping", "-n", "-c", "20", "-i", "0.2", "-W", "1", ip], timeout=15)
    pg = parse_ping(out)
    detail["ping"] = pg
    if pg["received"] == 0:
        return result("network", YELLOW, f"{host} ({ip}) does not answer ping - asleep?", detail)
    if measure:
        rc, out = run(["iperf3", "-c", ip, "-t", "10", "-J", "-R"], timeout=25)
        try:
            j = json.loads(out[out.index("{"):])
            mbps = j["end"]["sum_received"]["bits_per_second"] / 1e6
            detail["throughput_mbps"] = round(mbps, 1)
        except (ValueError, KeyError, TypeError):
            detail["throughput_mbps"] = None
            detail["iperf3"] = "no iperf3 server on the workstation? (Install-LinkProbe.ps1)" if rc else out[-200:]
    else:
        try:
            with open(p(STATE + "/link.json"), encoding="utf-8") as fh:
                detail["throughput_mbps"] = json.load(fh).get("throughput_mbps")
        except (OSError, ValueError):
            detail["throughput_mbps"] = None
    link_bad = (pg["jitter_ms"] or 0) > JITTER_BAD_MS or pg["loss_pct"] > LOSS_BAD_PCT
    rung = recommend_rung(detail["throughput_mbps"], pg["jitter_ms"], pg["loss_pct"])
    detail.update(link_bad=link_bad, rung=rung, path=",".join(sorted({i["kind"] for i in up})))
    if measure and detail.get("throughput_mbps") is not None:
        try:
            with open(p(STATE + "/link.json"), "w", encoding="utf-8") as fh:
                json.dump({"rung": rung, "throughput_mbps": detail["throughput_mbps"],
                           "jitter_ms": pg["jitter_ms"], "loss_pct": pg["loss_pct"], "at": time.time()}, fh)
        except OSError:
            pass
    tput = f", {detail['throughput_mbps']} Mbps" if detail.get("throughput_mbps") else ""
    summary = (f"{detail['path']} path to {host}: jitter {pg['jitter_ms']} ms, loss {pg['loss_pct']}%, "
               f"rtt {pg['rtt_avg_ms']} ms{tput}; quality {rung}")
    return result("network", YELLOW if link_bad else GREEN, summary + (" - link is shaky" if link_bad else ""),
                  detail)


def check_sunshine() -> dict:
    host, ip, _ = workstation()
    if not ip:
        return result("sunshine", YELLOW, f"{host} not found; Sunshine not checked", {})
    states = {}
    for port in (47989, 47984):
        try:
            with socket.create_connection((ip, port), timeout=2):
                states[port] = "open"
        except ConnectionRefusedError:
            states[port] = "refused"
        except OSError:
            states[port] = "timeout"
    if all(v == "open" for v in states.values()):
        return result("sunshine", GREEN, f"Sunshine answering on {ip}:47989/47984", {"ports": states})
    if any(v == "refused" for v in states.values()):
        return result("sunshine", RED, f"{host} is up but Sunshine is not listening", {"ports": states})
    return result("sunshine", YELLOW, f"{host} not answering (asleep?)", {"ports": states})


def check_pairing() -> dict:
    host, ip, _ = workstation()
    if not ip:
        return result("pairing", SKIP, "workstation not reachable; pairing not checked", {})
    rc, out = run([MOONLIGHT, "list", host], timeout=30)
    low = out.lower()
    if rc == 0:
        apps = [x.strip() for x in out.splitlines() if x.strip()]
        return result("pairing", GREEN, f"paired with {host} ({len(apps)} apps)", {"apps": apps[:50]})
    if "pair" in low:
        return result("pairing", RED, f"not paired with {host}: use Menu > Pair on the TV", {"output": out[-300:]})
    return result("pairing", YELLOW, f"moonlight-qt list failed (rc {rc})", {"output": out[-300:]})


def check_xone() -> dict:
    """Written by the kernel post-install hook and by couch-maint at boot."""
    try:
        with open(p(STATE + "/xone-status.json"), encoding="utf-8") as fh:
            d = json.load(fh)
    except (OSError, ValueError):
        return result("drivers", SKIP, "no gamepad-driver check recorded yet", {})
    if d.get("ok"):
        return result("drivers", GREEN, f"xone/xpadneo built for kernel {d.get('kernel')}", d)
    return result("drivers", RED, f"gamepad driver missing for kernel {d.get('kernel')}: {d.get('detail')}", d)


def check_disk() -> dict:
    detail, worst = {}, GREEN
    for mount in ("/", "/var"):
        try:
            u = shutil.disk_usage(p(mount))
        except OSError:
            continue
        free_pct = 100.0 * u.free / u.total
        detail[mount] = {"free_gb": round(u.free / 1e9, 1), "free_pct": round(free_pct, 1)}
        if free_pct < 5 or u.free < 1e9:
            worst = RED
        elif free_pct < 15 and worst == GREEN:
            worst = YELLOW
    root = detail.get("/", {})
    return result("disk", worst, f"{root.get('free_gb')} GB free ({root.get('free_pct')}%)", detail)


def check_streams() -> dict:
    lines = read(STATE + "/streams.jsonl").splitlines()[-3:]
    streams = []
    for ln in lines:
        try:
            streams.append(json.loads(ln))
        except ValueError:
            continue
    if not streams:
        return result("streams", SKIP, "no streams yet", {"last": []})
    desc = "; ".join(f"{s.get('app')} {s.get('duration_s')}s exit {s.get('exit_code')}" for s in reversed(streams))
    failed = sum(1 for s in streams if s.get("exit_code") not in (0, None))
    return result("streams", YELLOW if failed >= 2 else GREEN, desc, {"last": streams})


MEASURE = False


def check_network_cfg() -> dict:
    return check_network(MEASURE)


CHECKS = [check_display, check_gamepad, check_decode, check_network_cfg, check_sunshine, check_pairing,
          check_services, check_xone, check_disk, check_streams]


def overall(results: list[dict]) -> str:
    worst = max((_RANK[r["status"]] for r in results), default=0)
    return {0: GREEN, 1: YELLOW, 2: RED}[worst]


def run_all() -> dict:
    results = []
    for fn in CHECKS:
        try:
            results.append(fn())
        except Exception as exc:  # a broken check must never hide the others
            results.append(result(fn.__name__.replace("check_", "").replace("_cfg", ""), RED,
                                  f"check crashed: {exc!r}"))
    return {"doctor_version": VERSION, "overall": overall(results), "checks": results}


def render_text(report: dict) -> str:
    marks = {GREEN: "[ OK ]", YELLOW: "[WARN]", RED: "[FAIL]", SKIP: "[SKIP]"}
    lines = [f"couch-doctor v{report['doctor_version']}  overall: {report['overall'].upper()}"]
    for r in report["checks"]:
        lines.append(f"{marks[r['status']]} {r['check']:<9} {r['summary']}")
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    global SYSROOT, MEASURE
    ap = argparse.ArgumentParser(prog="couch-doctor", description="read-only couchbox health matrix")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--measure", action="store_true", help="also run the 10 s iperf3 throughput probe")
    ap.add_argument("--sysroot", default=os.environ.get("COUCH_SYSROOT", "/"), help=argparse.SUPPRESS)
    args = ap.parse_args(argv)
    SYSROOT = args.sysroot
    MEASURE = args.measure
    report = run_all()
    print(json.dumps(report, indent=2) if args.json else render_text(report))
    return _RANK[report["overall"]]


if __name__ == "__main__":
    sys.exit(main())
