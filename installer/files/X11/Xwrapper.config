# couchbox: written by installer/install.sh (replaces xserver-xorg-legacy's default "console" policy).
# allowed_users=anybody : couch-kiosk.service starts Xorg as the "couch" service user, which is not a console login,
#                         so the Debian default ("console") refuses it.
# needs_root_rights=yes : Xorg runs via the setuid Xorg.wrap and opens the DRM/input devices itself - the form proven
#                         on the NUC 2026-11-05. "auto" (rootless Xorg through logind) is untested on this box.
allowed_users=anybody
needs_root_rights=yes
